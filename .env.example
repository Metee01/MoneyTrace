# Demo proxy endpoint (optional).
# When set, a "Use Demo API" option appears in the AI settings and chat panel.
# Requests are routed through the serverless proxy at `api/demo.ts`, which
# owns the shared demo API key (DEMO_API_KEY env var on Vercel) so the key
# never ships in the client bundle. The proxy enforces quotas server-side.
#
# For production on Vercel: VITE_DEMO_PROXY_URL=/api/demo
# For local development against a deployed proxy, use its full URL,
# e.g. VITE_DEMO_PROXY_URL=https://your-site.vercel.app/api/demo
VITE_DEMO_PROXY_URL=
